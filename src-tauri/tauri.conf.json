{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "TermX",
	"version": "0.1.0",
	"identifier": "dev.termx.app",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:5183",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "TermX",
				"width": 1440,
				"height": 900,
				"minWidth": 960,
				"minHeight": 600,
				"center": true,
				"resizable": true,
				"decorations": false,
				"theme": "Dark"
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"shortDescription": "TermX 终端工作区",
		"longDescription": "把终端、SFTP、端口转发、主机监控放在同一个工作区的 SSH 客户端"
	}
}
