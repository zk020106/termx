{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "TermX 主窗口与「复制标签页到新窗口」打开的会话窗口（session-*）的默认能力：窗口控制（无边框自绘标题栏）+ 事件通道（终端输出）+ 逐条列出的应用命令（见 build.rs）",
	"windows": ["main", "session-*"],
	"permissions": [
		"core:default",
		"core:event:default",
		"core:window:allow-minimize",
		"core:window:allow-maximize",
		"core:window:allow-unmaximize",
		"core:window:allow-toggle-maximize",
		"core:window:allow-is-maximized",
		"core:window:allow-close",
		"core:window:allow-start-dragging",
		"dialog:default",
		"allow-pty-spawn",
		"allow-pty-write",
		"allow-pty-resize",
		"allow-pty-kill",
		"allow-probe-hosts",
		"allow-probe-host",
		"allow-config-load",
		"allow-config-save",
		"allow-config-location",
		"allow-ssh-connect",
		"allow-ssh-write",
		"allow-ssh-resize",
		"allow-ssh-ping-rtt",
		"allow-ssh-disconnect",
		"allow-ssh-exec",
		"allow-forward-start",
		"allow-forward-stop",
		"allow-forward-list",
		"allow-ssh-trust-host",
		"allow-ssh-replace-host-key",
		"allow-ssh-auth-respond",
		"allow-ssh-agent-identities",
		"allow-secret-save",
		"allow-secret-load",
		"allow-secret-delete",
		"allow-secret-available",
		"allow-sftp-list",
		"allow-sftp-realpath",
		"allow-sftp-mkdir",
		"allow-sftp-remove",
		"allow-sftp-rename",
		"allow-sftp-chmod",
		"allow-sftp-read-file",
		"allow-sftp-write-file",
		"allow-sftp-upload",
		"allow-sftp-download",
		"allow-sftp-stat",
		"allow-fs-local-stat",
		"allow-transfer-check",
		"allow-transfer-start",
		"allow-transfer-control",
		"allow-transfer-set-limits",
		"allow-transfer-discard-partial",
		"allow-fs-reveal",
		"allow-fs-local-list",
		"allow-fs-local-home",
		"allow-fs-local-drives",
		"allow-fs-local-mkdir",
		"allow-fs-local-remove",
		"allow-fs-local-rename",
		"allow-fs-local-read-file",
		"allow-fs-local-write-file",
		"allow-fs-open-path",
		"allow-fs-open-with",
		"allow-fs-temp-file-path",
		"allow-fs-local-extract",
		"allow-fs-local-copy",
		"allow-known-hosts-list",
		"allow-known-hosts-remove",
		"allow-key-vault-import",
		"allow-key-vault-generate",
		"allow-key-vault-delete",
		"allow-key-vault-set-passphrase",
		"allow-key-vault-status",
		"allow-known-hosts-import",
		"allow-ssh-session-pwd",
		"allow-ssh-upload-clipboard-image",
		"allow-ssh-write-bytes",
		"allow-ssh-zmodem-release",
		"allow-zmodem-pick-upload-files",
		"allow-zmodem-read-chunk",
		"allow-zmodem-release-files",
		"allow-zmodem-pick-download-dir",
		"allow-zmodem-create-file",
		"allow-zmodem-write-chunk",
		"allow-zmodem-finish-file",
		"allow-ssh-drain",
		"allow-window-open-session",
		"allow-window-take-session-payload",
		"allow-window-own-session",
		"allow-sftp-copy-between"
	]
}
